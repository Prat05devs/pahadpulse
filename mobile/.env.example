# Copy to `.env` and adjust. Only EXPO_PUBLIC_* variables reach the JS bundle.
#
# Anything here IS SHIPPED INSIDE THE APP and can be read by anyone who downloads it.
# Never put a secret in this file. The API this app talks to is public and unauthenticated,
# which is the only reason a bare base URL is safe to embed.

# Android emulator reaches the host machine on 10.0.2.2; an iOS simulator can use localhost.
# On a physical device use your machine's LAN IP, e.g. http://192.168.1.5:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Where the public web portal lives. Used for "open in browser" and source links.
EXPO_PUBLIC_WEB_URL=https://pahadpulse.in
