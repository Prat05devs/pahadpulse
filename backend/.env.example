NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=debug
SERVER_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
# Host port published by Docker. Set both ports to 3307 if local MySQL already uses 3306.
DB_HOST_PORT=3306
DB_USER=pahad
DB_PASSWORD=pahad
DB_NAME=pahad_pulse
DB_POOL_LIMIT=20
# Enable for managed MySQL. Certificate and hostname verification remain required.
DB_SSL=false
# Optional provider CA certificate (PEM contents; literal \n escapes are supported).
# Leave empty to use Node's trusted certificate authorities.
DB_SSL_CA=

CORS_ORIGIN=http://localhost:3001

# Keep false for local commands. Production enables the ingestion/notification scheduler on
# exactly one API instance.
SCHEDULER_ENABLED=false

# Optional locally; required in production when Expo push-access security is enabled.
# EXPO_ACCESS_TOKEN=replace-with-the-token-from-the-EAS-project
