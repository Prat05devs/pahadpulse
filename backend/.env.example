NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=debug
SERVER_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=5432
# Host port published by Docker. Set both ports to 5433 if local PostgreSQL uses 5432.
DB_HOST_PORT=5432
DB_USER=pahad
DB_PASSWORD=pahad
DB_NAME=pahad_pulse
DB_POOL_LIMIT=20
# Enable for managed PostgreSQL. Certificate and hostname verification remain required.
DB_SSL=false
# Optional provider CA certificate (PEM contents; literal \n escapes are supported).
# Leave empty to use Node's trusted certificate authorities.
DB_SSL_CA=

CORS_ORIGIN=http://localhost:3001

# Keep false for local commands. Production enables the ingestion/notification scheduler on
# exactly one API instance.
SCHEDULER_ENABLED=false

# Optional locally; required in production when Expo push-access security is enabled.
# EXPO_ACCESS_TOKEN=replace-with-the-token-from-the-EAS-project

# Optional locally. In production, set both SACHET values when the direct NDMA feed is
# blocked from the API region; the server rejects a half-configured pair.
# SACHET_RELAY_URL=https://www.pahadpulse.live/api/relay/sachet
# SACHET_RELAY_KEY=replace-with-at-least-32-random-characters

# Free NASA FIRMS map key. Without it, satellite fire ingestion is skipped cleanly.
# FIRMS_MAP_KEY=replace-with-your-firms-map-key
