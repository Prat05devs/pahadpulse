# @storybook/nextjs@7 declares a peer range that stops at next@14, and this app runs next@15.
# npm's default strict peer resolution therefore fails with ERESOLVE on a clean install —
# which is exactly what a CI or Vercel build does. The tree installs and builds correctly; the
# peer range is simply out of date upstream.
#
# Remove this line once Storybook is upgraded to a release that supports Next 15.
legacy-peer-deps=true
